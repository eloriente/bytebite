GEMINI_API_KEY=

# Auth.js
AUTH_SECRET=changeme-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Seed inicial de los 2 usuarios (opcional, valores por defecto en prisma/seed.ts)
