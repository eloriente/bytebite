datasource db {
  provider = "sqlite"
  url      = "file:./data/bytebite.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  name              String
  role              String             @default("USER")
  goal              String?
  // Se incrementa al pedir "cerrar sesión en todos los dispositivos" (ver auth.ts). El JWT
  // de cada sesión lleva el valor con el que se emitió; si no coincide con el de la BD, la
  // sesión se considera revocada.
  sessionVersion    Int                @default(0)
  reminderEnabled   Boolean            @default(false)
  reminderHour      Int?
  diets             Diet[]
  conversation      Conversation?
  authenticators    Authenticator[]
  pushSubscriptions PushSubscription[]
  createdAt         DateTime           @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// Una passkey (credencial WebAuthn) por fila; un usuario puede tener varias
// (distintos dispositivos). Sin contraseñas: esta es la única forma de autenticarse.
model Authenticator {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String   @unique
  publicKey    String
  counter      Int      @default(0)
  transports   String?
  createdAt    DateTime @default(now())
}

// Estado de corta vida del ceremonial WebAuthn (challenges pendientes, tokens de sesión de
// un solo uso). Vive en la base de datos, no en memoria del proceso: los distintos Route
// Handlers de Next.js no comparten de forma fiable el estado de un módulo en memoria (cada
// ruta puede recompilarse/reinstanciarse de forma independiente, sobre todo en dev), así que
// un Map en memoria entre /options y /verify perdía datos de forma intermitente.
model PendingAuthAction {
  id        String   @id @default(cuid())
  kind      String
  data      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Diet {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  isActive  Boolean   @default(true)
  pdfPath   String?
  days      DietDay[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model DietDay {
  id        String @id @default(cuid())
  dietId    String
  diet      Diet   @relation(fields: [dietId], references: [id], onDelete: Cascade)
  dayOfWeek String
  meals     Meal[]
}

model Meal {
  id        String       @id @default(cuid())
  dietDayId String
  dietDay   DietDay      @relation(fields: [dietDayId], references: [id], onDelete: Cascade)
  name      String
  order     Int
  options   MealOption[]
}

model MealOption {
  id          String  @id @default(cuid())
  mealId      String
  meal        Meal    @relation(fields: [mealId], references: [id], onDelete: Cascade)
  name        String
  description String?
  items       Item[]
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  createdAt DateTime  @default(now())
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  imagePath      String?
  mode           String       @default("ask")
  editOperations String?
  editStatus     String?
  createdAt      DateTime     @default(now())
}

model Item {
  id           String     @id @default(cuid())
  mealOptionId String
  mealOption   MealOption @relation(fields: [mealOptionId], references: [id], onDelete: Cascade)
  ingredient   String
  amount       String
  checked      Boolean    @default(false)
  calories     Int?
  protein      Float?
  carbs        Float?
  fat          Float?
}
